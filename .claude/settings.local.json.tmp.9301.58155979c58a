{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:1541u-documentation.readthedocs.io)",
      "WebSearch",
      "WebFetch(domain:www.lemon64.com)",
      "Bash(curl -s --max-time 5 http://192.168.8.173/v1/version)",
      "Bash(curl -s --max-time 5 http://192.168.8.173/v1/info)",
      "Bash(curl -s --max-time 5 -X PUT \"http://192.168.8.173/v1/machine:input\" -w \"\\\\nHTTP %{http_code}\\\\n\")",
      "Bash(curl -s --max-time 5 \"http://192.168.8.173/v1/streams\" -w \"\\\\nHTTP %{http_code}\\\\n\")",
      "Bash(curl -s --max-time 5 \"http://192.168.8.173/v1/drives\" -w \"\\\\nHTTP %{http_code}\\\\n\")",
      "Bash(ip route *)",
      "Bash(ip -brief addr)",
      "Bash(ping -c1 -W2 192.168.8.173)",
      "Bash(curl -s --max-time 5 \"http://192.168.8.173/v1/configs\")",
      "Bash(curl -s --max-time 5 \"http://192.168.8.173/v1/configs/network%20settings\")",
      "Bash(curl -s --max-time 5 \"http://192.168.8.173/v1/configs/Ethernet%20Settings\")",
      "Bash(curl -s --max-time 5 \"http://192.168.8.173/v1/configs/WiFi%20settings\")",
      "Bash(curl -s --max-time 5 \"http://192.168.8.173/v1/configs/Data%20Streams\")",
      "Bash(ip neigh *)",
      "Bash(arp -a)",
      "Bash(make *)",
      "Bash(timeout 6 ./c64uv --dest 192.168.8.197:11000)",
      "Bash(ping -c1 -W2 -I eth0 192.168.8.236)",
      "Bash(ping -c1 -W2 -I wlan0 192.168.8.236)",
      "Bash(curl -s --max-time 8 -X PUT \"http://192.168.8.236/v1/streams/video:start?ip=192.168.8.124\" -w \"HTTP %{http_code}\\\\n\")",
      "Bash(curl -s --max-time 8 -X PUT \"http://192.168.8.236/v1/streams/video:start?ip=192.168.8.197\" -w \"HTTP %{http_code}\\\\n\")",
      "Bash(timeout 3 python3 -c ' *)",
      "Bash(curl -s -X PUT \"http://192.168.8.236/v1/streams/video:stop\" -o /dev/null -w \"old stream stopped: HTTP %{http_code}\\\\n\")",
      "Bash(./c64uv *)",
      "Bash(git add *)",
      "Bash(git commit -q -m ' *)",
      "Bash(gh repo *)"
    ]
  }
}
